# Go API
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://skillbridge_user:your_password@host.docker.internal:5432/skillbridge?sslmode=disable
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_RESET_SECRET=replace-with-a-different-long-random-reset-secret
JWT_ACCESS_EXPIRES_IN=7d
JWT_RESET_EXPIRES_IN=15m
BCRYPT_SALT_ROUNDS=12

# GitHub OAuth configuration
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:5173/api/github/auth/github/callback

# GitHub Personal Access Token (for API calls)
GITHUB_TOKEN=your_personal_access_token_here

# Encryption key for storing tokens securely
GITHUB_ENCRYPTION_KEY=your_secure_encryption_key_here

# Application URLs
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000

# Session configuration
SESSION_SECRET=your_session_secret_here